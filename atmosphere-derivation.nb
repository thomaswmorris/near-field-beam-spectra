920f8b619296"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"MaternFourierTransform2D", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{"Gamma", "[", "nu", "]"}]], 
     RowBox[{"A", " ", 
      SuperscriptBox["4", 
       RowBox[{"-", "nu"}]], " ", 
      SuperscriptBox["a", 
       RowBox[{"2", " ", "nu"}]], 
      SuperscriptBox["b", 
       RowBox[{"2", "+", 
        RowBox[{"2", " ", "nu"}]}]], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"cx", " ", "kx"}], "+", 
          RowBox[{"cy", " ", "ky"}]}], ")"}]}]], "\[Pi]", " ", 
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "-", "nu"}], "]"}], " ", 
      RowBox[{"Matern", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "-", "nu"}], ",", 
        RowBox[{"b", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["a", "2"], "+", 
            SuperscriptBox["kx", "2"], "+", 
            SuperscriptBox["ky", "2"]}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}]}]}]}], "]"}]}]}], 
    RowBox[{"Exp", "[", 
     RowBox[{"I", 
      RowBox[{"(", " ", 
       RowBox[{
        RowBox[{"kx", " ", "cx"}], " ", "+", " ", 
        RowBox[{"ky", " ", "cy"}]}], ")"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", " ", "Pi"}], ")"}], "^", "2"}]}], 
    "MaternFourierTransform2D"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"A", "->", 
      RowBox[{"A", " ", 
       SuperscriptBox["4", 
        RowBox[{"-", "nu"}]], " ", 
       SuperscriptBox["a", 
        RowBox[{"2", " ", "nu"}]], "  ", 
       SuperscriptBox["b", 
        RowBox[{"2", "+", 
         RowBox[{"2", " ", "nu"}]}]], "  ", "\[Pi]", " ", 
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{
          RowBox[{"-", "1"}], "-", "nu"}], "]"}], "/", 
        RowBox[{"Gamma", "[", "nu", "]"}]}]}]}], ",", 
     RowBox[{"a", "->", "b"}], ",", 
     RowBox[{"b", "->", "a"}], ",", 
     RowBox[{"nu", "->", 
      RowBox[{
       RowBox[{"-", "nu"}], "-", "1"}]}], ",", 
     RowBox[{"kx", "->", "x"}], ",", 
     RowBox[{"ky", "->", "y"}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9836279336170197`*^9, 3.983627940854801*^9}, {

Cell[BoxData[{
 RowBox[{
  RowBox[{"ExpandMatern", "[", 
   RowBox[{"nu_", ",", "r_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"r", "^", "nu"}], " ", 
   RowBox[{"BesselK", "[", 
    RowBox[{"nu", ",", "r"}], "]"}], 
   RowBox[{
    RowBox[{"2", "^", 
     RowBox[{"(", 
      RowBox[{"1", "-", "nu"}], ")"}]}], "/", 
    RowBox[{"Gamma", "[", "nu", "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ConstractBesselK", "[", 
   RowBox[{"nu_", ",", "r_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Matern", "[", 
    RowBox[{"nu", ",", "r"}], "]"}], "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"r", "^", "nu"}], " ", 
     RowBox[{
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{"1", "-", "nu"}], ")"}]}], "/", 
      RowBox[{"Gamma", "[", "nu", "]"}]}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MaternFlipOrder", "[", 
   RowBox[{"nu_", ",", "r_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "nu"}], "]"}], "/", 
    RowBox[{"Gamma", "[", "nu", "]"}]}], 
   RowBox[{"Matern", "[", 
    RowBox[{
     RowBox[{"-", "nu"}], ",", "r"}], "]"}], 
   RowBox[{"2", "^", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "2"}], "nu"}], ")"}]}], 
   RowBox[{"r", "^", 
    RowBox[{"(", 
     RowBox[{"2", "nu"}], ")"}]}]}]}]}], "Input",
 CellChangeTimes->{{3.9836320006789083`*^9, 3.983632075941566*^9}, {
  3.983632175461533*^9, 3.983632179026722*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"b01f74b2-d0e6-4437-a603-d6d733950d86"],

Cell[TextData[{
 StyleBox["We define the Fourier transform identity and make sure it is an \
involution (up to a factor of ", "DisplayFormula"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"2", "\[Pi]"}], TraditionalForm], "errors" -> {}, "input" -> 
      "2\\pi", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], ")"}], TraditionalForm]],ExpressionUUID->
  "ce2578e0-7e3b-464d-890c-d9dbc887610e"]
}], "Text",

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MaternFourierTransform1D", "=", 
    RowBox[{"A", " ", 
     RowBox[{"2", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "nu"}], ")"}]}], 
     RowBox[{"Pi", "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "2"}], ")"}]}], 
     RowBox[{"a", "^", 
      RowBox[{"(", 
       RowBox[{"2", " ", "nu"}], ")"}]}], 
     RowBox[{"b", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "nu"}], " ", "+", " ", "1"}], ")"}]}], 
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"-", "nu"}], "-", 
        RowBox[{"1", "/", "2"}]}], "]"}], "/", 
      RowBox[{"Gamma", "[", "nu", "]"}]}], 
     RowBox[{"Matern", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "nu"}], "-", 
        RowBox[{"1", "/", "2"}]}], ",", 
       RowBox[{"b", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"k", "^", "2"}], "+", 
           RowBox[{"a", "^", "2"}]}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}]}]}]}], "]"}], 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", "k", " ", "c"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"MaternFourierTransform1D", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"MaternFourierTransform1D", "/.", 
      RowBox[{"{", 
       RowBox[{"Matern", "->", "MaternFlipOrder"}], "}"}]}], "]"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "Pi"}], ")"}]}], "MaternFourierTransform1D"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"A", "->", 
      RowBox[{"A", " ", 
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], " ", "nu"}], ")"}]}], 
       RowBox[{"Pi", "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}]}], 
       RowBox[{"a", "^", 
        RowBox[{"(", 
         RowBox[{"2", " ", "nu"}], ")"}]}], 
       RowBox[{"b", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "nu"}], "+", "1"}], ")"}]}], 
       RowBox[{
        RowBox[{"Gamma", "[", 
         RowBox[{
          RowBox[{"-", "nu"}], "-", 
          RowBox[{"1", "/", "2"}]}], "]"}], "/", 
        RowBox[{"Gamma", "[", "nu", "]"}]}]}]}], ",", 
     RowBox[{"a", "->", "b"}], ",", 
     RowBox[{"b", "->", "a"}], ",", 
     RowBox[{"nu", "->", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "2"]}], "-", "nu"}]}], ",", 
     RowBox[{"k", "->", "x"}], ",", 
     RowBox[{"c", "->", "0"}]}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{"MaternFourierTransform1D", "/.", 
   RowBox[{"{", 
    RowBox[{"Matern", "->", "MaternFlipOrder"}], "}"}]}], "]"}]}], "Input",

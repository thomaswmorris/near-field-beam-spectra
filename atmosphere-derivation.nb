Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GammaSub", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{
       RowBox[{"-", "2"}], "/", "3"}], "]"}], "->", 
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{"1", "/", "3"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "/", "3"}], ")"}]}]}], ",", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{"5", "/", "6"}], "]"}], "->", 
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{"11", "/", "6"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"5", "/", "6"}], ")"}]}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.9955476323442717`*^9, 3.995547678692163*^9}},

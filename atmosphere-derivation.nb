Cell[CellGroupData[{

Cell["Atmospheric correlations", "Subtitle",
 CellChangeTimes->{{3.994937659587541*^9, 
  3.994937663348575*^9}},ExpressionUUID->"a4cc85b4-93da-451d-82a7-\
564687eb336d"],

Cell[TextData[{
 "We start with our expression for the angular covariance of the atmosphere, \
\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["t", "TI"], 
            StyleBox["m", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Theta]", 
              StyleBox["x", "TI"]], ",", 
             SubscriptBox["\[Theta]", 
              StyleBox["y", "TI"]], ",", "\[Tau]"}], ")"}], "\[LongEqual]", 
         SubsuperscriptBox["\[Sigma]", 
          RowBox[{
            StyleBox["h", "TI"], 
            StyleBox["u", "TI"], 
            StyleBox["m", "TI"]}], "2"], 
         SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
         SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["z", "TI"], 
          StyleBox["i", "TI"]], "\[DifferentialD]", 
         SubscriptBox[
          StyleBox["z", "TI"], 
          StyleBox["j", "TI"]], " ", "exp", 
         RowBox[{"(", 
           RowBox[{"-", 
             FractionBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["z", "TI"], 
                 StyleBox["i", "TI"]], "+", 
                SubscriptBox[
                 StyleBox["z", "TI"], 
                 StyleBox["j", "TI"]]}], 
              SubscriptBox[
               StyleBox["z", "TI"], "0"]]}], ")"}], 
         SubscriptBox[
          StyleBox["M", "TI"], 
          RowBox[{"1", "/", "3"}]], 
         RowBox[{"(", 
           RowBox[{
             SqrtBox[
              RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{
                    SubscriptBox[
                    StyleBox["x", "TI"], 
                    StyleBox["i", "TI"]], "-", 
                    SubscriptBox[
                    StyleBox["x", "TI"], 
                    StyleBox["j", "TI"]], "+", 
                    SubscriptBox[
                    StyleBox["v", "TI"], 
                    StyleBox["x", "TI"]], "\[Tau]", "+", 
                    StyleBox["z", "TI"], 
                    SubscriptBox["\[Theta]", 
                    StyleBox["x", "TI"]]}], ")"}], "2"], "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{
                    SubscriptBox[
                    StyleBox["y", "TI"], 
                    StyleBox["i", "TI"]], "-", 
                    SubscriptBox[
                    StyleBox["y", "TI"], 
                    StyleBox["j", "TI"]], "+", 
                    SubscriptBox[
                    StyleBox["v", "TI"], 
                    StyleBox["y", "TI"]], "\[Tau]", "+", 
                    StyleBox["z", "TI"], 
                    SubscriptBox["\[Theta]", 
                    StyleBox["y", "TI"]]}], ")"}], "2"], "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{
                    SubscriptBox[
                    StyleBox["z", "TI"], 
                    StyleBox["i", "TI"]], "-", 
                    SubscriptBox[
                    StyleBox["z", "TI"], 
                    StyleBox["j", "TI"]]}], ")"}], "2"]}]], "/", 
             SubscriptBox[
              StyleBox["r", "TI"], "0"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "C_{atm}(\\theta_x, \\theta_y, \\tau) = \\sigma_{hum}^2 \\int_0^\\infty \
\\int_0^\\infty dz_i \\, dz_j \\,\\exp \\left ( - \\frac{z_i + z_j}{z_0} \
\\right ) M_{1/3} \\left ( \\sqrt{(x_i - x_j + v_x\\tau + z\\theta_x)^2 + \
(y_i - y_j + v_y\\tau + z\\theta_y)^2 + (z_i - z_j)^2 }/r_0  \\right )", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a89071a8-4b97-43c0-861b-e18f93e30f71"],
 "\nThis is approximately equal (up to a constant, see paper) to\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{
            StyleBox["a", "TI"], 

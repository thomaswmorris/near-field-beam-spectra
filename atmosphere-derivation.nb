Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"Patmavg", "=", 
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"s", ">", "0"}], "&&", 
      RowBox[{"Rfov", ">", "0"}], "&&", 
      RowBox[{"kx", ">", "0"}], "&&", 
      RowBox[{"ky", ">", "0"}]}], ",", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"atmosphericPowerSpectrumPerLayerWindMarginalized", "/.", 
         RowBox[{"{", 
          RowBox[{"tau", "->", 
           RowBox[{"tj", "-", "ti"}]}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"ti", ",", 
          RowBox[{
           RowBox[{"-", "Rfov"}], "/", "s"}], ",", 
          RowBox[{"Rfov", "/", "s"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"tj", ",", 
          RowBox[{
           RowBox[{"-", "Rfov"}], "/", "s"}], ",", 

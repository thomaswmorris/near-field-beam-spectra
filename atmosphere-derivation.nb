   3.999771658457415*^9, 3.999772225927682*^9, 3.99977227353615*^9, 
   3.999781331061371*^9, 4.000975476349975*^9, 4.0016015645106373`*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"660ff5f8-1547-436d-9454-5c55f9cf2257"]
}, Open  ]],

Cell[TextData[{
 "One last niggle before we start; the above is undefined for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["b", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "b=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9d05759d-0d70-42d5-80db-e6dacb3f67bf"],
 ". We can flip the order and set ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["b", "TI"], TraditionalForm], "errors" -> {}, "input" -> "b", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a56e39fd-25ca-40f1-9b2b-7e4a169245be"],
 " to 0 giving us"
}], "Text",
 CellChangeTimes->{{3.983632823187598*^9, 3.9836328488995657`*^9}, {
  3.983633121722398*^9, 3.983633158346537*^9}, {3.995130465751975*^9, 
  3.995130466693535*^9}},ExpressionUUID->"4fc3e603-4a5e-4e6b-a57c-\
6afced7b0f57"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{"b", ">", "0"}], ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"MaternFourierTransform2D", "/.", 
      RowBox[{"{", 
       RowBox[{"Matern", "->", "MaternFlipOrder"}], "}"}]}], "]"}]}], "]"}], "/.", 
  RowBox[{"{", 
   RowBox[{"b", "->", "0"}], "}"}]}]], "Input",
 CellChangeTimes->{{3.983632856335923*^9, 3.983632880169674*^9}, {
  3.983632983281595*^9, 3.983633119214486*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"21a14c83-ac28-446e-a0be-b1d587e01623"],

Cell[BoxData[
 RowBox[{"4", " ", 
  SuperscriptBox["a", 
   RowBox[{"2", " ", "nu"}]], " ", "A", " ", 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["a", "2"], "+", 
     SuperscriptBox["kx", "2"], "+", 
     SuperscriptBox["ky", "2"]}], ")"}], 
   RowBox[{
    RowBox[{"-", "1"}], "-", "nu"}]], " ", "nu", " ", "\[Pi]", " ", 
  RowBox[{"Matern", "[", 
   RowBox[{
    RowBox[{"1", "+", "nu"}], ",", "0"}], "]"}]}]], "Output",

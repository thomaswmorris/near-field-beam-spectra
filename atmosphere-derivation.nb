  3.999781318795542*^9}},ExpressionUUID->"d947fcee-5e92-4d33-90db-\
7c49a552ab9b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"beam", "=", 
  RowBox[{
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"thetax", "^", "2"}], "+", 
        RowBox[{"thetay", "^", "2"}]}], ")"}]}], "/", 
     RowBox[{"(", 
      RowBox[{"2", 
       RowBox[{"angularBeamSigma", "^", "2"}]}], ")"}]}], "]"}], "/", 
   RowBox[{"(", 
    RowBox[{"2", " ", "Pi", " ", 
     RowBox[{"angularBeamSigma", "^", "2"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ftbeam", "=", 
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"angularBeamSigma", ">", "0"}], "&&", 
      RowBox[{
       SqrtBox[
        RowBox[{
         SuperscriptBox["kx", "2"], "+", 
         SuperscriptBox["ky", "2"]}]], ">", "0"}]}], ",", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"2", " ", "Pi", " ", 
       RowBox[{"FourierTransform", "[", 
        RowBox[{"beam", ",", 
         RowBox[{"{", 
          RowBox[{"thetax", ",", "thetay"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"kx", ",", "ky"}], "}"}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"atmosphericPowerSpectrumPerLayerWithBeams", "=", 
  RowBox[{"atmosphericPowerSpectrumPerLayer", "*", 
   RowBox[{"ftbeam", "^", "2", 
    RowBox[{"(*", 
     RowBox[{"/.", 
      RowBox[{"{", 
       RowBox[{"angularBeamSigma", "->", 
        RowBox[{
         RowBox[{"sigma", "[", "beam", "]"}], "/", "z"}]}], "}"}]}], 
     "*)"}]}]}]}]}], "Input",

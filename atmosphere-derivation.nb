Cell[CellGroupData[{

Cell["Mapping", "Subtitle",
 CellChangeTimes->{{3.9953795265345907`*^9, 
  3.9953795337922*^9}},ExpressionUUID->"80446dd0-7f4e-48ad-a569-013585441794"],

Cell[TextData[{
 "A maximum likelihood mapper is hard to investigate analytically, and it won\
\[CloseCurlyQuote]t do too much at high multipole (since noise modes below \
the white noise level are weighted equally, so it\[CloseCurlyQuote]s the same \
as binning basically), so let\[CloseCurlyQuote]s just bin the data. If we \
take the value of each pixel to be the average of all samples, then the \
covariance of two pixels is the average value of the covariance matrix of all \
their samples. Assuming that all scans are independent, this is then a sum \
over integrals ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{
            StyleBox["m", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["p", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Theta]", 
              StyleBox["x", "TI"]], ",", 
             SubscriptBox["\[Theta]", 
              StyleBox["y", "TI"]]}], ")"}], "\[LongEqual]", 
         FractionBox["1", 
          SubsuperscriptBox[
           StyleBox["T", "TI"], 
           RowBox[{
             StyleBox["p", "TI"], 
             StyleBox["e", "TI"], 
             StyleBox["r", "TI"], 
             StyleBox["p", "TI"], 
             StyleBox["i", "TI"], 
             StyleBox["x", "TI"], 
             StyleBox["e", "TI"], 
             StyleBox["l", "TI"]}], "2"]], 
         UnderscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[Element]", 
            StyleBox["S", "TI"]}], LimitsPositioning -> True], "\[Integral]", 
         "\[Integral]", 
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["t", "TI"], 
          StyleBox["i", "TI"]], "\[DifferentialD]", 
         SubscriptBox[
          StyleBox["t", "TI"], 
          StyleBox["j", "TI"]], "\[CapitalTheta]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["t", "TI"], 
              StyleBox["i", "TI"]], ",", "0", ",", "0", ",", 
             StyleBox["a", "TI"], ",", "\[Phi]"}], ")"}], "\[CapitalTheta]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["t", "TI"], 
              StyleBox["j", "TI"]], ",", 
             SubscriptBox["\[Theta]", 
              StyleBox["x", "TI"]], ",", 
             SubscriptBox["\[Theta]", 
              StyleBox["y", "TI"]], ",", 
             StyleBox["a", "TI"], ",", "\[Phi]"}], ")"}], "\[Integral]", 
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["t", "TI"], 
            StyleBox["m", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Theta]", 
              StyleBox["x", "TI"]], ",", 
             SubscriptBox["\[Theta]", 
              StyleBox["y", "TI"]], ",", 
             SubscriptBox[
              StyleBox["t", "TI"], 
              StyleBox["j", "TI"]], "-", 
             SubscriptBox[
              StyleBox["t", "TI"], 
              StyleBox["i", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "C_{map}(\\theta_x, \\theta_y) = \\frac{1}{T_{per pixel}^2} \\sum_{i \
\\in S}\n       \\iint dt_i \\, dt_j \\Theta(t_i, 0, 0, a, \\phi) \
\\Theta(t_j, \\theta_x, \\theta_y, a, \\phi) \\int dC_{atm}(\\theta_x, \
\\theta_y, t_j - t_i)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5ae33957-f280-488b-8f07-f35de7084050"],
 ". This convolution is messy, and so we will do it in $k$ space. But that \
Fourier transform is also tricky due to the $theta$ dependence in the \
indicator function. We intuit that when the distance $\\theta$ between the \
pixels is small, we almost always sample both pixels at the same time. This \
lets us write \[LineSeparator] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{
            StyleBox["m", "TI"], 
            StyleBox["a", "TI"], 
            StyleBox["p", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Theta]", 
              StyleBox["x", "TI"]], ",", 
             SubscriptBox["\[Theta]", 
              StyleBox["y", "TI"]]}], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SubscriptBox[
             StyleBox["N", "TI"], 
             RowBox[{
               StyleBox["s", "TI"], 
               StyleBox["c", "TI"], 
               StyleBox["a", "TI"], 
               StyleBox["n", "TI"], 
               StyleBox["s", "TI"]}]], 
            SubscriptBox["\[Theta]", 
             RowBox[{
               StyleBox["f", "TI"], 
               StyleBox["o", "TI"], 
               StyleBox["v", "TI"]}]]}], 
          RowBox[{
            SubscriptBox[
             StyleBox["D", "TI"], 
             RowBox[{
               StyleBox["m", "TI"], 
               StyleBox["a", "TI"], 
               StyleBox["p", "TI"]}]], 
            SubsuperscriptBox[
             StyleBox["T", "TI"], 
             RowBox[{
               StyleBox["p", "TI"], 
               StyleBox["e", "TI"], 
               StyleBox["r", "TI"], 
               StyleBox["p", "TI"], 
               StyleBox["i", "TI"], 
               StyleBox["x", "TI"], 
               StyleBox["e", "TI"], 
               StyleBox["l", "TI"]}], "2"]}]], 
         SubsuperscriptBox["\[Integral]", 
          RowBox[{"-", 
            SubscriptBox["\[Theta]", 
             RowBox[{
               StyleBox["f", "TI"], 
               StyleBox["o", "TI"], 
               StyleBox["v", "TI"]}]], "/", 
            RowBox[{"(", 
              RowBox[{"2", 
                StyleBox["s", "TI"]}], ")"}]}], 
          RowBox[{"+", 
            SubscriptBox["\[Theta]", 
             RowBox[{
               StyleBox["f", "TI"], 
               StyleBox["o", "TI"], 
               StyleBox["v", "TI"]}]], "/", 
            RowBox[{"(", 
              RowBox[{"2", 
                StyleBox["s", "TI"]}], ")"}]}]], 
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["t", "TI"], 
          StyleBox["i", "TI"]], 
         SubsuperscriptBox["\[Integral]", 
          RowBox[{"-", 
            SubscriptBox["\[Theta]", 
             RowBox[{
               StyleBox["f", "TI"], 
               StyleBox["o", "TI"], 
               StyleBox["v", "TI"]}]], "/", 
            RowBox[{"(", 
              RowBox[{"2", 
                StyleBox["s", "TI"]}], ")"}]}], 
          RowBox[{"+", 
            SubscriptBox["\[Theta]", 
             RowBox[{
               StyleBox["f", "TI"], 
               StyleBox["o", "TI"], 
               StyleBox["v", "TI"]}]], "/", 
            RowBox[{"(", 
              RowBox[{"2", 
                StyleBox["s", "TI"]}], ")"}]}]], 
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["t", "TI"], 
          StyleBox["j", "TI"]], "\[Integral]", 
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["t", "TI"], 
            StyleBox["m", "TI"]}]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Theta]", 
              StyleBox["x", "TI"]], ",", 
             SubscriptBox["\[Theta]", 
              StyleBox["y", "TI"]], ",", 
             SubscriptBox[
              StyleBox["t", "TI"], 
              StyleBox["j", "TI"]], "-", 
             SubscriptBox[
              StyleBox["t", "TI"], 
              StyleBox["i", "TI"]], ",", 
             StyleBox["z", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "C_{map}(\\theta_x, \\theta_y) = \\frac{N_{scans} \
\\theta_{fov}}{D_{map}T_{per pixel}^2} \
\\int_{-\\theta_{fov}/(2s)}^{+\\theta_{fov}/(2s)} dt_i \
\\int_{-\\theta_{fov}/(2s)}^{+\\theta_{fov}/(2s)} dt_j  \\int \
dC_{atm}(\\theta_x, \\theta_y, t_j - t_i, z)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "875376cf-bcec-4853-ba90-876f1e22f104"],
 ". Still a tricky integral, but we only care about the Fourier transform of \
this integral, and so we Fourier transform to get the atmospheric power \
spectrum per layer as"
}], "Text",
 CellChangeTimes->{{3.995379537837349*^9, 3.995379625517519*^9}, {
   3.995379665996697*^9, 3.995379717828578*^9}, {3.995380217931476*^9, 
   3.995380219477378*^9}, {3.9953804301904783`*^9, 3.99538067449055*^9}, {
   3.9953809222460203`*^9, 3.995380999620146*^9}, {3.99538107784266*^9, 
   3.9953810883064337`*^9}, {3.995381127362218*^9, 3.9953811577738037`*^9}, {
   3.995381306996252*^9, 3.995381360450527*^9}, {3.995381851107541*^9, 
   3.995382005156618*^9}, {3.995382074973793*^9, 3.995382090163623*^9}, {
   3.995382269872311*^9, 3.995382310365861*^9}, {3.995382376708798*^9, 
   3.995382391423274*^9}, {3.995383591382172*^9, 3.995383593109646*^9}, {
   3.995460650806943*^9, 3.9954607202382097`*^9}, {3.995460844197407*^9, 
   3.995460867636757*^9}, {3.995460966341666*^9, 3.9954609772930317`*^9}, {
   3.999764881718442*^9, 3.999764952439966*^9}, 3.999777976295957*^9, {
   3.999778015387272*^9, 
   3.999778017569289*^9}},ExpressionUUID->"b5e9a68b-5619-476e-91e4-\
ebf56486339f"],


   3.999781332510935*^9, 4.0009754800733147`*^9, 4.00160156740578*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"4ce59c94-be8d-4b45-9549-667d5bac56bd"]
}, Open  ]],


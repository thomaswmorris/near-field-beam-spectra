Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"farray", "=", 
    RowBox[{"fdet", " ", "Ndet", " ", 
     RowBox[{"pixelArea", " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"4", " ", 
        RowBox[{"Rfov", "^", "2"}]}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Rmap", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"fsky", "*", "4"}], "]"}]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Rfov", "=", 
   RowBox[{"fov", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Tperscan", "=", 
    RowBox[{"Dmap", "/", "s"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Nscans", "=", 
     RowBox[{"Tsurvey", "/", "Tperscan"}]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NETdet", "=", 
   RowBox[{"NETarray", " ", 
    RowBox[{"Sqrt", "[", "Ndet", "]"}]}]}], ";", 
  RowBox[{"Nperpixel", "=", 
   RowBox[{
    RowBox[{"Nscans", " ", "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "Pi", " ", "*", "  ", "Dmap"}], ")"}]}], "*", 
    RowBox[{"Integrate", "[", 
     RowBox[{"farray", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{
         RowBox[{"-", "Rfov"}], "/", "s"}], ",", 
        RowBox[{"Rfov", "/", "s"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"phi", ",", "0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", 
        RowBox[{"-", "Rfov"}], ",", "Rfov"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tperpixel", "=", 
   RowBox[{"Nperpixel", "/", "fdet"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mapDepth", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"pixelArea", "*", 
     RowBox[{
      RowBox[{"NETdet", "^", "2"}], "/", "Tperpixel"}]}], "]"}]}], 
  RowBox[{"(*", 
   RowBox[{"/.", 
    RowBox[{"{", 
     RowBox[{"Rmap", "->", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"fsky", "*", "4"}], "]"}]}], "}"}]}], "*)"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{

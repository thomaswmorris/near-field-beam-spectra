Cell[TextData[{
 "and its 2D analog (again checking for involution)\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Integral]", 
          RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
         SubsuperscriptBox["\[Integral]", 
          RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
         SubscriptBox[
          StyleBox["M", "TI"], "\[Nu]"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["a", "TI"], 
             SuperscriptBox[
              RowBox[{"(", 
                RowBox[{
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["x", "TI"], "+", 
                    SubscriptBox[
                    StyleBox["c", "TI"], 
                    StyleBox["x", "TI"]]}], ")"}], "2"], "+", 
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["y", "TI"], "+", 
                    SubscriptBox[
                    StyleBox["c", "TI"], 
                    StyleBox["y", "TI"]]}], ")"}], "2"], "+", 
                  SuperscriptBox[
                   StyleBox["b", "TI"], "2"]}], ")"}], 
              RowBox[{"1", "/", "2"}]]}], "]"}], "]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            SubscriptBox[
             StyleBox["k", "TI"], 
             StyleBox["x", "TI"]], 
            StyleBox["x", "TI"], "+", 
            SubscriptBox[
             StyleBox["k", "TI"], 
             StyleBox["y", "TI"]], 
            StyleBox["y", "TI"]}]], 
         StyleBox["d", "TI"], 
         StyleBox["x", "TI"], 
         StyleBox["d", "TI"], 
         StyleBox["y", "TI"], "\[LongEqual]", 
         SuperscriptBox["2", 
          RowBox[{"-", "\[Nu]"}]], 
         FractionBox[
          RowBox[{"\[CapitalGamma]", "(", 
            RowBox[{"-", "\[Nu]", "-", "1"}], ")"}], 
          RowBox[{"\[CapitalGamma]", "(", "\[Nu]", ")"}]], 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          RowBox[{"2", "\[Nu]"}]], 
         SuperscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{"2", "\[Nu]", "+", "2"}]], 
         SubscriptBox[
          StyleBox["M", "TI"], 
          RowBox[{"-", "\[Nu]", "-", "1"}]], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["b", "TI"], 
             SuperscriptBox[
              RowBox[{"(", 
                RowBox[{
                  SuperscriptBox[
                   StyleBox["a", "TI"], "2"], "+", 
                  SuperscriptBox[
                   StyleBox["k", "TI"], "2"]}], ")"}], 
              RowBox[{"1", "/", "2"}]]}], "]"}], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", 
            StyleBox["i", "TI"], 
            RowBox[{"(", 
              RowBox[{
                SubscriptBox[
                 StyleBox["k", "TI"], 
                 StyleBox["x", "TI"]], 
                SubscriptBox[
                 StyleBox["c", "TI"], 
                 StyleBox["x", "TI"]], "+", 
                SubscriptBox[
                 StyleBox["k", "TI"], 
                 StyleBox["y", "TI"]], 
                StyleBox["y", "TI"]}], ")"}]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\int_{-\\infty}^\\infty \\int_{-\\infty}^\\infty M_{ \\nu} \\left [a \
\\left ((x+c_x)^2 + (y+c_y)^2 + b^2 \\right )^{1/2}] \\right ] e^{i k_x x + \
k_y y} dx dy\n    = 2^{-\\nu} \\frac{\\Gamma(-\\nu-1)}{\\Gamma(\\nu)} \
a^{2\\nu}b^{2\\nu+2} M_{-\\nu - 1} \\left [ b \\left ( a^2 + k^2\\right \
)^{1/2}\\right ] e^{-i (k_x c_x + k_y y)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4d0e9a22-9087-4cf9-97e7-f2fdf5653bab"],
 "\[LineSeparator]"
}], "Text",
 CellChangeTimes->{{3.983627832573111*^9, 3.983627861726726*^9}, {
  3.983628126980896*^9, 3.9836281579562397`*^9}, {3.9836332772249937`*^9, 

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubsuperscriptBox["\[Integral]", 
         RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
        SubscriptBox[
         StyleBox["M", "TI"], "\[Nu]"], 
        RowBox[{"[", 
          RowBox[{
            StyleBox["a", "TI"], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 SuperscriptBox[
                  StyleBox["x", "TI"], "2"], "+", 
                 SuperscriptBox[
                  StyleBox["b", "TI"], "2"]}], ")"}], 
             RowBox[{"1", "/", "2"}]]}], "]"}], "]", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{"-", 
           StyleBox["i", "TI"], 
           StyleBox["k", "TI"], 
           StyleBox["x", "TI"]}]], 
        StyleBox["d", "TI"], 
        StyleBox["x", "TI"], "\[LongEqual]", 
        FractionBox[
         RowBox[{
           SuperscriptBox["\[Pi]", 
            RowBox[{"1", "/", "2"}]], 
           SuperscriptBox[
            StyleBox["a", "TI"], 
            RowBox[{"2", "\[Nu]"}]], 
           SuperscriptBox[
            StyleBox["b", "TI"], 
            RowBox[{"2", "\[Nu]", "+", "1"}]]}], 
         SuperscriptBox["2", 
          RowBox[{"2", "\[Nu]"}]]], 
        FractionBox[
         RowBox[{"\[CapitalGamma]", "(", 
           FractionBox[
            RowBox[{"-", "\[Nu]", "-", "1"}], "2"], ")"}], 
         RowBox[{"\[CapitalGamma]", "(", "\[Nu]", ")"}]], 
        SubscriptBox[
         StyleBox["M", "TI"], 
         RowBox[{"-", "\[Nu]", "-", "1", "/", "2"}]], 
        RowBox[{"[", 
          RowBox[{
            StyleBox["b", "TI"], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{
                 SuperscriptBox[
                  StyleBox["k", "TI"], "2"], "+", 
                 SuperscriptBox[
                  StyleBox["a", "TI"], "2"]}], ")"}], 
             RowBox[{"1", "/", "2"}]]}], "]"}], "."}], TraditionalForm], 
    "errors" -> {}, "input" -> 
    "\\int_{-\\infty}^\\infty M_{ \\nu} \\left [a \\left (x^2 + b^2 \\right \
)^{1/2}] \\right ] e^{-i k x} dx = \\frac{ \\pi^{1/2} a^{ 2\\nu} b^{2\\nu + \
1}}{2^{2\\nu}} \\frac{\\Gamma(- \\nu - \\tfrac{1}{2})}{\\Gamma( \\nu)} M_{- \
\\nu - 1/2} \\left [b (k^2 + a^2)^{1/2} \\right ] .", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"908042e4-d126-4bd5-9a1d-f99a437dbfea"]], \
"Text",
 CellChangeTimes->{{3.983627092551013*^9, 
  3.9836270985008373`*^9}},ExpressionUUID->"9a272147-9799-415f-8eac-\
409cd83d0ce1"],


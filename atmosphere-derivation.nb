Cell["\<\
Let\[CloseCurlyQuote]s deal with the wind. We expect that on average the wind \
speed should be zero, but with some variability. We model it as a Gaussian \
and integrate to marginalize over all wind velocities\
\>", "Text",
 CellChangeTimes->{{3.995473884374609*^9, 3.995473921405807*^9}, {
  3.999781484905488*^9, 
  3.999781490070209*^9}},ExpressionUUID->"3c3bb9e0-5fff-4132-8b66-\
d342b2d25764"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"windPrior", "=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"vx", "^", "2"}], "+", 
         RowBox[{"vy", "^", "2"}]}], ")"}]}], "/", 
      RowBox[{"(", 
       RowBox[{"2", 
        RowBox[{"v", "^", "2"}]}], ")"}]}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", "Pi", " ", 
      RowBox[{"v", "^", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{"v", ">", "0"}], ",", 
    RowBox[{"Integrate", "[", 
     RowBox[{"windPrior", ",", 
      RowBox[{"{", 
       RowBox[{"vx", ",", 
        RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"vy", ",", 
        RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}]}], "]"}],
   "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"kx", "^", "2"}], "+", 
     RowBox[{"ky", "^", "2"}]}], "->", 
    RowBox[{"k", "^", "2"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{"atmosphericPowerSpectrumPerLayerWindMarginalized", "=", 
  RowBox[{
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{"v", ">", "0"}], ",", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
       "atmosphericPowerSpectrumPerLayerWithBeams", " ", "*", " ", 
        "windPrior"}], ",", 
       RowBox[{"{", 
        RowBox[{"vx", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"vy", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}]}], 
    "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"kx", "^", "2"}], "+", 
      RowBox[{"ky", "^", "2"}]}], "->", 
     RowBox[{"k", "^", "2"}]}], "}"}]}]}]}], "Input",
